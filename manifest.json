{
	"manifest_version": 2,
	"name": "fxclipboard",
	"author": "rtldg",
	"version": "2.2",
	"description": "Rewrite things in your clipboard, like domains, maybe with regex",
	"homepage_url": "https://github.com/rtldg/fxclipboard",
	"icons": {
		"48": "icons/fxclipboard48.png",
		"96": "icons/fxclipboard96.png"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "{846f05b8-874e-422d-b688-24f84e124e5d}",
			"data_collection_permissions": {
				"required": ["none"]
			},
			"strict_min_version": "128.0"
		}
	},

	"permissions": [
		"storage",
		"clipboardRead",
		"clipboardWrite"
	],

	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},

	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["rewrite.js", "content.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],

	"background": {
		"scripts": ["rewrite.js", "background.js"]
	}
}
